generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OfferStatus {
  rascunho
  publicado
  pausado
  arquivado
  lixeira
}

model Offer {
  id   String @id @default(cuid())
  slug String @unique

  title       String
  partnerName String

  city       String
  categoryId String
  status     OfferStatus @default(rascunho)

  // Campos opcionais (para crescer sem dor)
  description String?
  imageUrl    String?

  imageUrls String[] @default([])
  priceText  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([categoryId])
  @@index([status])
  @@index([partnerName])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Multi-tenant (já preparado)
  tenantId String?

  // Quem fez
  actorRole String
  actorName String?

  // O que aconteceu
  action     String
  entityType String
  entityId   String?

  // Antes/depois
  before Json?
  after  Json?

  @@index([createdAt])
  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([actorRole])
}
